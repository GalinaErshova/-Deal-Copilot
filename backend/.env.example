# Пример настроек backend. Скопируйте файл в .env и меняйте значения там.
# Имена переменных соответствуют полям Settings в app/config.py.
# Безопасные параметры для интерфейса публикуются через GET /api/settings;
# секреты и внутренние настройки модели этим endpoint не выдаются.

# Хранилище данных
# URL подключения SQLAlchemy; относительный путь считается от каталога backend.
DATABASE_URL=sqlite:///./data/deal_copilot.db
# Каталог для локальных данных приложения; создаётся при запуске.
DATA_DIR=./data
# Каталог сохранённых оригиналов загруженных документов.
UPLOAD_DIR=./data/uploads

# Поставщик модели и доступ к API
# Выбор провайдера: mimo — API Xiaomi MiMo, local — локальный OpenAI-совместимый сервер, mock — заглушка.
LLM_PROVIDER=mimo
# Модель для обычных задач извлечения требований.
LLM_DEFAULT_MODEL=mimo-v2.6-flash
# Модель для сложных задач; ModelGateway выбирает её при вызове с complex_task=true.
LLM_COMPLEX_MODEL=mimo-v2.6-pro
# OpenAI-совместимый базовый URL модели (облако или локальный сервер llama.cpp).
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Секретный ключ MiMo. Заполните для реальных запросов; не публикуйте и не коммитьте.
MIMO_API_KEY=
# Принудительно использует демо-заглушку. Для провайдера mimo пустой ключ тоже
# включает заглушку; провайдер local использует локальный endpoint без облачного ключа.
DEMO_MODE=true

# CORS и приём файлов
# Разрешённые origin браузера; несколько значений указываются через запятую.
CORS_ORIGINS=http://localhost:3000
# Допустимые расширения файлов через запятую; список также задаёт accept в форме загрузки.
ACCEPTED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx
# Максимальный размер одного файла в байтах.
MAX_UPLOAD_BYTES=20000000
# Максимальная суммарная загрузка одного запроса в байтах.
MAX_UPLOAD_TOTAL_BYTES=50000000
# Максимальное количество файлов в одном запросе загрузки.
MAX_FILES_PER_UPLOAD=20
# Максимум строк, читаемых из одной таблицы XLSX; лишние строки отбрасываются с предупреждением.
MAX_SPREADSHEET_ROWS=5000
# Максимальная длина объединённого текста документов, передаваемого модели.
MAX_EXTRACTION_CHARS=500000
# Максимальная длина одного фрагмента запроса локальной модели; большие документы обрабатываются по частям.
LLM_INPUT_CHUNK_CHARS=12000
# Сопоставление словесной уверенности модели с числом 0–1; нужно, когда модель отвечает «высокая» вместо числа.
EXTRACTION_CONFIDENCE_LABEL_MAP={"высокая":0.95,"высокий":0.95,"high":0.95,"средняя":0.7,"средний":0.7,"medium":0.7,"низкая":0.4,"низкий":0.4,"low":0.4}

# Рабочий график и значения расчёта по умолчанию
# Рабочих дней в месяце; участвует в оценке часов труда.
WORKING_DAYS_PER_MONTH=22
# Часов в одной смене; участвует в оценке трудоёмкости.
HOURS_PER_SHIFT=8
# Начальная площадь объекта в м² в форме расчёта; после извлечения её нужно подтвердить.
DEFAULT_AREA_M2=1200
# Начальный тариф за м² в месяц, включая НДС.
DEFAULT_SERVICE_PRICE_PER_M2_MONTH=180
# Начальная производительность уборки в м² за смену.
DEFAULT_PRODUCTIVITY_M2_PER_SHIFT=800
# Норма часов в месяц на одну штатную единицу FTE.
DEFAULT_MONTHLY_HOURS_PER_FTE=164
# Начальная стоимость одного рабочего часа персонала.
DEFAULT_HOURLY_STAFF_COST=350
# Коэффициент замещения персонала; должен быть не меньше 1.
DEFAULT_REPLACEMENT_COEFFICIENT=1.12
# Ежемесячные расходы на управление объектом.
DEFAULT_MANAGER_MONTHLY_COST=8000
# Начальные затраты на материалы в расчёте на м² за месяц.
DEFAULT_MATERIALS_PER_M2_MONTH=7
# Начальные затраты на оборудование в расчёте на м² за месяц.
DEFAULT_EQUIPMENT_PER_M2_MONTH=2
# Ежемесячные логистические расходы.
DEFAULT_LOGISTICS_MONTHLY=3000
# Доля накладных расходов от выручки без НДС, от 0 включительно до 1 не включительно.
DEFAULT_OVERHEAD_RATE=0.08
# Доля резерва непредвиденных расходов от прямых затрат, от 0 до 1.
DEFAULT_CONTINGENCY_RATE=0.03
# Целевая маржа для расчёта целевого тарифа и решения BID WITH CONDITIONS.
DEFAULT_TARGET_MARGIN=0.15
# Ставка НДС, доля от 0 до 1; используется при переводе тарифа в выручку без НДС.
DEFAULT_VAT_RATE=0.22
# Начальная длительность договора в месяцах.
DEFAULT_CONTRACT_MONTHS=12
# Относительный допуск при сравнении площади расчёта с подтверждённой площадью.
AREA_MATCH_TOLERANCE=0.000001
# Минимальное число физических сотрудников даже при малом расчётном FTE.
MINIMUM_PHYSICAL_STAFF=1

# Валюта и формат чисел
# Числовой код валюты для Intl.NumberFormat в браузере, например RUB или USD.
CURRENCY_CODE=RUB
# Символ валюты для подписей единиц измерения и ставок.
CURRENCY_UNIT_SYMBOL=₽
# Локаль форматирования чисел в интерфейсе.
DISPLAY_LOCALE=ru-RU
# Число знаков после запятой в отображении обычных чисел.
DISPLAY_NUMBER_MAX_FRACTION_DIGITS=1
# Максимум знаков после запятой в денежных суммах интерфейса.
DISPLAY_CURRENCY_MAX_FRACTION_DIGITS=0
# Множитель для перевода долей в проценты при показе в интерфейсе.
DISPLAY_PERCENTAGE_FACTOR=100
# Число знаков после запятой в процентах интерфейса.
DISPLAY_PERCENTAGE_DECIMAL_PLACES=1
# Число знаков после запятой в денежных полях результата API.
CURRENCY_DECIMAL_PLACES=2
# Точность округления часов труда в результате расчёта.
LABOR_HOURS_DECIMAL_PLACES=2
# Точность округления FTE в результате расчёта.
FTE_DECIMAL_PLACES=2
# Точность округления маржи в результате расчёта.
MARGIN_DECIMAL_PLACES=4
# Точность округления тарифа в сообщении о необходимом повышении цены.
CONDITION_PRICE_DECIMAL_PLACES=1
# Подпись единицы тарифа в условиях решения; укажите в нужной валюте/периоде.
CONDITION_PRICE_UNIT=₽/м²/мес

# Решение и отображение чувствительности
# Текстовая подпись сценария без изменения цены.
BASE_SENSITIVITY_LABEL=Base
# Порог уверенности извлечения, выше которого UI помечает поле как уверенное.
CONFIDENCE_GOOD_THRESHOLD=0.9
# Граница маржи для NO BID: решение срабатывает, когда маржа ниже этого значения.
# Значение 0 по умолчанию означает отказ при марже ниже безубыточности.
NO_BID_MARGIN_THRESHOLD=0
# Набор изменений тарифа для анализа чувствительности, доли через запятую.
# Каждое значение должно быть больше -1; 0 — исходная цена.
SENSITIVITY_DELTAS=-0.20,-0.10,-0.05,0,0.05,0.10,0.20
# Минимальная и максимальная ширина полосы чувствительности в процентах.
SENSITIVITY_BAR_MIN_WIDTH=4
SENSITIVITY_BAR_MAX_WIDTH=100
# Сдвиг маржи и масштаб полосы чувствительности в графике интерфейса.
SENSITIVITY_BAR_MARGIN_OFFSET=0.2
SENSITIVITY_BAR_SCALE=180

# Извлечение требований
# Идентификатор версии инструкции; сохраняется в журнале pipeline для аудита.
EXTRACTION_PROMPT_VERSION=cleaning_requirements_v2
# JSON-ответ модели в режиме mock; используйте для локальной отладки сценария извлечения.
# По умолчанию пустые поля, чтобы заглушка не выдавала вымышленные требования.
MOCK_EXTRACTION_PAYLOAD={"fields":[],"missing_fields":[],"contradictions":[]}
# Необязательная замена системной инструкции извлечения требований.
# Если нужна своя инструкция, задайте полную строку/многострочное значение;
# без переменной используется шаблон по умолчанию из app/config.py.
# EXTRACTION_SYSTEM_PROMPT="Инструкция модели на русском языке..."
