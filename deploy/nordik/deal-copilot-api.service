[Unit]
Description=Deal Copilot API (FastAPI + SQLite)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=dealcopilot
Group=dealcopilot
WorkingDirectory=/opt/deal-copilot/current/backend
EnvironmentFile=/etc/deal-copilot/backend.env
# Порт API открыт только для gala-msk (сайт) по wg0 и локально.
ExecStartPre=+/bin/sh -c 'iptables -C INPUT -i lo -p tcp --dport 8020 -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -i lo -p tcp --dport 8020 -j ACCEPT; iptables -C INPUT -s 10.66.66.3/32 -i wg0 -p tcp --dport 8020 -j ACCEPT 2>/dev/null || iptables -I INPUT 2 -s 10.66.66.3/32 -i wg0 -p tcp --dport 8020 -j ACCEPT; iptables -C INPUT -p tcp --dport 8020 -j DROP 2>/dev/null || iptables -A INPUT -p tcp --dport 8020 -j DROP'
ExecStart=/opt/deal-copilot/current/backend/.venv/bin/uvicorn app.main:app --host 10.66.66.16 --port 8020 --proxy-headers --forwarded-allow-ips 10.66.66.3
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/deal-copilot

[Install]
WantedBy=multi-user.target
